// Converted from src/gtk/http_page.ui by an AI assistant
using Gtk 4.0;
using Adw 1;

template HttpPage: Adw.PreferencesPage {
  Adw.PreferencesGroup http_request_group {
    title: _("Request Parameters");

    Adw.EntryRow http_entry_row {
      activates-default: true;
      // focusable: true; // Generally managed by the toolkit, true by default for EntryRow
      input-purpose: url;
      max-width-chars: 250;
      show-apply-button: true;
      title: _("URL to fetch HTTP headers from");
    }

    Adw.SwitchRow http_pragma_switch_row {
      subtitle: _("Enable this to send Akamai Pragma headers in your request");
      title: _("Akamai Debug Headers");
    }
  }

  Adw.PreferencesGroup { // Group for the error banner
    Adw.Banner http_error_banner {
      button-label: _("Dismiss");
      margin-bottom: 10;
      margin-top: 15;
      revealed: false;
    }
  }

  Adw.PreferencesGroup http_response_group {
    title: _("Response Headers");
    visible: false;

    Gtk.ColumnView http_column_view {
      enable-rubberband: true;
      margin-bottom: 10;
      margin-end: 10;
      margin-start: 10;
      margin-top: 10;
      model: Gtk.MultiSelection {}; // Assuming a new Gtk.MultiSelection is needed. This might need adjustment based on actual data binding in code.
      // overflow: hidden; // This is a CSS concept, Gtk.Overflow enum is used for scrollbars (visible, hidden, auto)
      reorderable: false;
      show-column-separators: true;
      show-row-separators: true;
      vexpand: true;

      columns: [
        Gtk.ColumnViewColumn header_name_column {
          factory: Gtk.SignalListItemFactory {}; // Placeholder, likely needs setup in code (e.g., connect signals for setup and bind)
          // fixed-width: 0; // In Blueprint, fixed-width often set directly if a value > 0, otherwise sizing is managed by expand/content.
          title: _("Response Header");
          // visible: false; // Columns are visible by default. If it should be initially hidden, this would be set.
                           // However, the .ui had visible=false for columns, which is unusual if they have titles.
                           // This might indicate they are shown/hidden dynamically.
        },
        Gtk.ColumnViewColumn header_value_column {
          expand: true;
          factory: Gtk.SignalListItemFactory {}; // Placeholder, likely needs setup in code
          resizable: true;
          sorter: Gtk.ColumnViewSorter {}; // Placeholder, likely needs setup in code (e.g. specifying sorting by which column if not implicit)
          title: _("Response Header Value");
          // visible: false;
        },
      ];
    }
  }
}
