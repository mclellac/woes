// Converted from src/gtk/webscan_page.ui by an AI assistant
using Gtk 4.0;
using Adw 1;

template WebScanPage: Adw.PreferencesPage {
  title: _("Web Scan"); // Assuming translatable

  Adw.PreferencesGroup { // Wrapper for the banner
    Adw.Banner error_banner_webscan {
      button-label: _("Dismiss");
      revealed: false;
      [signal button-clicked = on_error_banner_dismiss_clicked] // Removed semicolon
    }
  }

  Adw.PreferencesGroup {
    title: _("Scan Target"); // Assuming translatable

    Adw.EntryRow url_entry {
      title: _("Target URL"); // Assuming translatable
    }

    Adw.ActionRow {
      title: _("Actions"); // Assuming translatable
      // AdwActionRow can take activatable widgets directly as suffixes.
      // Using [suffix] for clarity, though direct child might also work for a single button.
      [suffix]
      Gtk.Button scan_button {
        label: _("Start Scan"); // Assuming translatable
        halign: end;
        valign: center;
        styles [ "suggested-action" ] // Removed colon
        [signal clicked = on_scan_button_clicked] // Removed semicolon
      }
    }
  }

  Adw.PreferencesGroup {
    title: _("Scan Results"); // Assuming translatable
    description: _("Output from the web vulnerability scan will appear here."); // Assuming translatable

    Gtk.ScrolledWindow { // Changed Adw.ScrolledWindow to Gtk.ScrolledWindow
      min-content-height: 200;
      vexpand: true;

      Gtk.TextView results_textview {
        editable: false;
        cursor-visible: false;
        wrap-mode: word_char;
      }
    }
  }
}
