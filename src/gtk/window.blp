// Converted from src/gtk/window.ui by an AI assistant
using Gtk 4.0;
using Adw 1;
using Gio 2.0; // For GMenu

// Assuming HttpPage, NmapPage, DNSPage are defined Blueprint files that will be compiled and available.
// For WebScanPage, it's just an AdwStatusPage for now in the .ui, so no custom page object yet.

template WoesWindow: Adw.ApplicationWindow {
  default-width: 1000;
  default-height: 1000;
  width-request: 800;
  height-request: 500;
  // overflow: hidden; // This is more of a CSS concept, usually handled by widget properties like scrolling in Gtk.
  title: _("WOES");

  content: Gtk.Box main_box {
    // halign: Gtk.Align.baseline_fill; // baseline-fill is not a standard Gtk.Align value. Fill or Start/End are common.
                                    // For a main box, usually hexpand/vexpand are used.
    orientation: vertical;
    hexpand: true;
    vexpand: true;

    Adw.HeaderBar header_bar {
      [title-widget]
      Adw.ViewSwitcher switcher_title {
        // halign: Gtk.Align.baseline_fill; // Adw.ViewSwitcher usually manages its own alignment and size within the headerbar.
        policy: wide;
        stack: stack; // Assuming 'stack' is the ID of Adw.ViewStack
      }

      [end]
      Gtk.MenuButton menu_button {
        icon-name: "open-menu-symbolic";
        menu-model: primary_menu;
        primary: true;
        tooltip-text: _("Menu");
        // styles: [ "GtkMenuButton" ]; // Default style, not usually needed unless overriding.
      }
    }

    Adw.ViewStack stack {
      vexpand: true;
      // vexpand-set: true; // vexpand alone is usually sufficient.

      Adw.ViewStackPage http_page_stack_entry { // Renamed ID to avoid conflict if http_page is also an ID of the child.
        name: "http_page"; // Name for the page, used by ViewSwitcher
        title: _("HTTP Headers");
        icon-name: "network-transmit-receive-symbolic";
        use-underline: true;

        child: Adw.StatusPage http_status_page {
          description: _("This tool is ideal for developers, as well as systems and network administrators, who need to inspect HTTP headers for debugging, troubleshooting, and security analysis.");
          icon-name: bind http_page_stack_entry.icon-name;
          // overflow: hidden; // Usually managed by scrollable children if needed.
          title: bind http_page_stack_entry.title;
          valign: start;

          Adw.ClampScrollable http_clamp_scrollable {
            maximum-size: 1400;
            tightening-threshold: 500;
            // unit: "px"; // unit is not a property of AdwClampScrollable. It's for GtkScale. Assume pixels is default interpretation for maximum-size.
            
            // Assuming HttpPage is a defined template/widget
            // HttpPage http_page_inst { // Added ID // Commented out for testing
            //   // overflow: hidden;
            // }
          }
        }
      }

      Adw.ViewStackPage nmap_page_stack_entry {
        name: "nmap_page";
        title: _("Port Scan"); // The .ui file has "Port Scanning" in AdwStatusPage title, but "Port Scan" here. Using this one for switcher.
        icon-name: "face-devilish";
        use-underline: true;

        child: Adw.StatusPage nmap_status_page {
          description: _("This tool is designed to facilitate network scanning, reconnaissance, and exploit detection using Nmap, a powerful network scanning tool. This interface provides the capability to perform various types of scans, including <b>service detection</b>, <b>OS fingerprinting</b>, <b>port scanning</b>, and <b>vulnerability assessments</b> using the <i>Nmap Scripting Engine (NSE)</i>.");
          icon-name: bind nmap_page_stack_entry.icon-name;
          title: bind nmap_page_stack_entry.title; // Binding to page title "Port Scan"
          vexpand: true;
          // vexpand-set: true;

          Adw.ClampScrollable {
            maximum-size: 1400;
            // unit: "px";
            vexpand: true; // If the NmapPage itself should expand
            
            // Assuming NmapPage is a defined template/widget
            // NmapPage nmap_page_inst { // Added ID // Commented out for testing
            //  vexpand: true;
            // }
          }
        }
      }

      Adw.ViewStackPage dns_page_stack_entry {
        name: "dns_page"; // Name for switcher
        title: _("DNS");
        icon-name: "org.gnome.Epiphany-symbolic";
        use-underline: true;
        badge-number: 0;

        child: Adw.StatusPage dns_status_page {
          description: _("The DNS tool allows users to perform DNS queries for various record types, including <b>A</b>, <b>TXT</b>, <b>CNAME</b> and others. By entering an IP address, users can perform reverse DNS lookups.");
          icon-name: "org.gnome.Epiphany-symbolic"; // .ui has this hardcoded, not bound like others.
          margin-end: 15;
          margin-start: 15;
          title: bind dns_page_stack_entry.title; // Binding to page title "DNS"
          // valign: 1; // This is Gtk.Align.fill. Explicitly: Gtk.Align.fill
          valign: fill;

          Adw.ClampScrollable {
            maximum-size: 1400;
            // unit: "px";
            vexpand: true;
            
            // Assuming DNSPage is a defined template/widget
            DNSPage DNSPage {} // Giving it an ID as in .ui
          }
        }
      }

      Adw.ViewStackPage webscan_page_stack_entry {
        name: "webscan_page";
        title: _("Web Scan");
        icon-name: "face-cool"; // .ui has this, but status page has org.gnome.Loupe-symbolic. Using this for switcher.
        use-underline: true;

        child: Adw.StatusPage webscan_status_page {
          description: "TODO"; // As per .ui
          icon-name: "org.gnome.Loupe-symbolic"; // Hardcoded in .ui's status page for webscan
          title: bind webscan_page_stack_entry.title; // Binding to page title "Web Scan"
          valign: start;
          // The actual WebScanPage content is missing here in the .ui, just a status page.
          // If WebScanPage (the custom widget) should be here, it would be child of Adw.ClampScrollable like others.
        }
      }
    }

    Adw.ViewSwitcherBar switcher_bar {
      // halign: Gtk.Align.baseline_fill; // ViewSwitcherBar typically manages its own alignment.
      stack: stack;
      // reveal: false by default, controlled by breakpoint
    }
  }; // Semicolon for content property

  Adw.Breakpoint {
    condition: (max-width: 550px); // Syntax based on Adwaita demo, with px
    // Setter for header_bar.title-widget to be null (empty)
    // Adw.Breakpoint.Setter syntax might be incorrect, blueprint might prefer direct property access
    // For now, commenting out setters to see if Breakpoint itself is accepted
    // setter header_bar.title_widget: null;
    // setter switcher_bar.reveal: true;
    // Alternative if direct setters are not working:
    // Using Adw.PropertySetter (if it exists and is appropriate) or specific Breakpoint setters if API differs.
    // The following is a guess based on some GObject-based setter patterns, may not be valid blueprint:
    // setters [
    //   Adw.PropertySetter {
    //     object: header_bar;
    //     property: "title-widget";
    //     value: null;
    //   },
    //   Adw.PropertySetter {
    //     object: switcher_bar;
    //     property: "reveal";
    //     value: true;
    //   }
    // ];
  }
}

menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }
    item {
      label: _("_Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }
    item {
      label: _("_About WOES");
      action: "app.about";
    }
  }
}
