// Converted from src/gtk/dns_page.ui by an AI assistant
using Gtk 4.0;
using Adw 1;

template DNSPage: Adw.PreferencesPage {
  Adw.PreferencesGroup dns_params_group {
    title: _("Lookup Parameters");

    Adw.EntryRow dns_ip_entryrow {
      input-purpose: url;
      show-apply-button: true;
      title: "Domain to lookup (or use an IP for reverse)";
    }

    Adw.ComboRow dns_record_type_dropdown {
      hexpand: true;
      hexpand-set: true;
      icon-name: "preferences-system-network-symbolic";
      model: Gtk.StringList {};
      selected: 0;
      subtitle-lines: 1;
      title: "Record type";
      valign: baseline_fill;
    }
  }

  Adw.PreferencesGroup {
    Adw.Banner dns_error_banner {
      button-label: _("Dismiss");
      revealed: false;
      margin-bottom: 10;
      margin-end: 10;
      margin-start: 10;
      margin-top: 10;
    }
  }

  Adw.PreferencesGroup dns_results_group {
    title: _("Lookup Results");

    Gtk.ScrolledWindow dns_results_scrolled_window {
      halign: baseline_fill;
      hexpand: true;
      hexpand-set: true;
      min-content-height: 400;
      vexpand: true;
      vexpand-set: true;
      // Removed has-frame, kinetic-scrolling, max-content-width, overflow as they are not for AdwScrolledWindow or handled differently
      // child: ...; // The child of GtkScrolledWindow is usually set dynamically in code
    }
  }
}
