<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="libadwaita" version="1.0"/>
  <template class="WebScanPage" parent="AdwPreferencesPage">
    <property name="title">Web Scan</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title">Scan Target</property>
        <child>
          <object class="AdwEntryRow" id="webscan_url_entry">
            <property name="title">Target URL</property>
            <property name="input-purpose">url</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwActionRow" id="webscan_action_row">
        <property name="title">Actions</property>
        <child type="suffix">
          <object class="GtkButton" id="webscan_start_button">
            <property name="label">Start Scan</property>
            <property name="halign">end</property>
            <property name="valign">center</property>
            <property name="has-frame">true</property>
            <style>
              <class name="suggested-action"/>
            </style>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwBanner" id="webscan_error_banner">
        <property name="button-label" translatable="yes">Dismiss</property>
        <property name="revealed">False</property>
        <!-- Signal handler for button-clicked will be connected in Python code -->
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title">Scan Results</property>
        <property name="description">Output from the web vulnerability scan will appear here.</property>
        <child>
          <object class="GtkScrolledWindow">
            <property name="min-content-height">300</property>
            <property name="vexpand">True</property>
            <property name="hexpand">True</property>
            <child>
              <object class="GtkTextView" id="webscan_results_textview">
                <property name="editable">False</property>
                <property name="cursor-visible">False</property>
                <property name="wrap-mode">word-char</property>
                <property name="monospace">True</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
