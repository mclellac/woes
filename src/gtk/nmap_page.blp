// Converted from src/gtk/nmap_page.ui by an AI assistant
using Gtk 4.0;
using Adw 1;

template NmapPage: Adw.PreferencesPage {
  Adw.PreferencesGroup nmap_config_group {
    title: _("Scan Configuration");

    Adw.EntryRow nmap_target_entryrow {
      activates-default: true;
      input-purpose: Gtk.InputPurpose.url;
      show-apply-button: true;
      title: _("IP/CIDR/FQDN to scan");
    }

    Adw.SwitchRow nmap_fingerprint_switchrow {
      subtitle: _("Enable this to attempt detection of the target OS");
      title: _("OS Fingerprinting (requires root)");
    }

    Adw.SwitchRow nmap_all_ports_switchrow {
      subtitle: "This will scan all ports between 0-65535";
      subtitle-lines: 2;
      title: _("Scan all ports (default is the top 200)");
    }

    Adw.ComboRow nmap_scripts_dropdown {
      icon-name: "emblem-documents-symbolic";
      model: Gtk.StringList nmap_list {
        strings: [
          "None",
          "default",
          "vuln",
          "discovery",
          "broadcast",
          "exploit",
          "http-grep",
          "http-enum",
          "http-config-backup",
          "http-wordpress-enum",
          "http-cors",
          "http-csrf",
          "http-cross-domain-policy",
          "mysql-users",
          "vulscan/vulscan",
          "firewalk",
        ];
      };
      selected: 0;
      subtitle: "Select script to use if desired";
      subtitle-lines: 1;
      title: "Nmap Scripts";
    }
  }

  Adw.PreferencesGroup {
    Adw.Banner nmap_warning_banner {
      title: _("<b>WARNING:</b> Do not use this tool on any hosts or networks <u>you do not explicitely have permission</u> to scan."); // Pango markup
      button-label: _("Dismiss");
      revealed: true;
      margin-bottom: 10;
      margin-end: 10;
      margin-start: 10;
      margin-top: 10;
    }
  }

  Adw.PreferencesGroup {
    Adw.Banner error_banner {
      button-label: _("Dismiss");
      revealed: false;
      margin-bottom: 10;
      margin-end: 10;
      margin-start: 10;
      margin-top: 10;
    }
  }

  Adw.PreferencesGroup {
    Adw.ActionRow nmap_status_row {
      title: _("Scan Status");
      subtitle: ""; // Explicitly empty as per UI
      margin-start: 10;
      margin-end: 10;
      
      [suffix]
      Adw.Spinner nmap_spinner {
        spinning: true;
        visible: false;
      }
    }
  }

  Adw.PreferencesGroup {
    title: _("Scan Output");

    Gtk.Box {
      orientation: Gtk.Orientation.horizontal;
      spacing: 6;
      halign: Gtk.Align.fill;
      hexpand: true;
      valign: Gtk.Align.fill;
      vexpand: true;

      Adw.PreferencesGroup nmap_target_group {
        title: _("Targets");
        halign: Gtk.Align.fill;
        hexpand: true;
        margin-bottom: 10;
        margin-end: 5;
        margin-top: 10;
        vexpand: true;

        Adw.ScrolledWindow nmap_target_scrolled_window {
          margin-bottom: 10;
          margin-end: 10;
          margin-start: 10;
          margin-top: 10;
          vexpand: true; // Ensure this is Adw.ScrolledWindow if it needs Adwaita specific features, else Gtk.ScrolledWindow

          Gtk.ListBox nmap_target_listbox {
            vexpand: true;
            // Children of ListBox are typically Gtk.ListBoxRow, added dynamically
          }
        }
      }

      Adw.PreferencesGroup nmap_results_group {
        title: _("Scan Results");
        halign: Gtk.Align.fill;
        hexpand: true;
        margin-bottom: 10;
        margin-start: 5; // Adjusted from margin-end in target group for spacing
        margin-top: 10;
        vexpand: true;

        Adw.ScrolledWindow nmap_results_adinw_scrolled_window { // Typo in original ID 'adinw', kept for consistency if referenced elsewhere
          halign: Gtk.Align.fill;
          hexpand: true;
          margin-bottom: 10;
          margin-end: 10;
          margin-start: 10;
          margin-top: 10;
          vexpand: true;
          // Child usually set dynamically for results display
        }
      }
    }
  }
}
