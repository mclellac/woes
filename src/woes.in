import os
import sys
import signal
import locale
import gettext
import requests
import platform

VERSION = "@VERSION@"
DATA_DIR = "@DATADIR@"
APP_ID = "@APPID@"
PKG_DATA_DIR = "@PKGDATADIR@"
PYTHON_SITE_PACKAGES_DIR = "@PYTHON_SITE_PACKAGES_DIR@"
GSETTINGS_SCHEMA_DIR = "@GSETTINGSSCHEMADIR@"
LOCALE_DIR = "@LOCALEDIR@"

print("APP_ID: ", APP_ID)
print("VERSION: ", VERSION)
print("GSETTINGS_SCHEMA_DIR: ", GSETTINGS_SCHEMA_DIR)

if PYTHON_SITE_PACKAGES_DIR and PYTHON_SITE_PACKAGES_DIR not in sys.path:
    sys.path.insert(0, PYTHON_SITE_PACKAGES_DIR)

if platform.system() == "Darwin":
    import glob
    for p in glob.glob("/usr/local/lib/python3.*/site-packages") + glob.glob("/opt/homebrew/lib/python3.*/site-packages"):
        if p not in sys.path:
            sys.path.insert(0, p)
    # Ensure GTK4 icon themes (adwaita-icon-theme) in Homebrew / usr/local paths are found by GTK4
    extra_xdg = ["/opt/homebrew/share", "/usr/local/share"]
    current_xdg = os.environ.get("XDG_DATA_DIRS", "")
    for d in extra_xdg:
        if os.path.exists(d) and d not in current_xdg.split(":"):
            current_xdg = (current_xdg + ":" + d) if current_xdg else d
    os.environ["XDG_DATA_DIRS"] = current_xdg

signal.signal(signal.SIGINT, signal.SIG_DFL)

# macOS (Darwin) gettext binding vs GLibc locale binding
if platform.system() == "Darwin":
    gettext.bindtextdomain("woes", LOCALE_DIR)
    gettext.textdomain("woes")
elif hasattr(locale, "bindtextdomain"):
    locale.bindtextdomain("woes", LOCALE_DIR)
    locale.textdomain("woes")
else:
    gettext.bindtextdomain("woes", LOCALE_DIR)
    gettext.textdomain("woes")

gettext.install("woes", LOCALE_DIR)

if __name__ == "__main__":
    print("--- sys.path before import gi ---")
    print(sys.path)
    print("---------------------------------")
    import gi

    from gi.repository import Gio

    resource = Gio.Resource.load(os.path.join(PKG_DATA_DIR, "woes.gresource"))
    resource._register()

    from woes import main

    sys.exit(main.main(VERSION))
