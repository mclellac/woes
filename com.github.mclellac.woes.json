{
  "app-id": "com.github.mclellac.woes",
  "runtime": "org.gnome.Platform",
  "runtime-version": "48",
  "sdk": "org.gnome.Sdk",
  "command": "woes",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=wayland",
    "--filesystem=xdg-config",
    "--filesystem=xdg-run/gvfsd",
    "--talk-name=org.freedesktop.FileManager1",
    "--env=PIP_INDEX_URL=https://pypi.org/simple",
    "--filesystem=home",
    "--device=all",
    "--socket=system-bus"
  ],
  "cleanup": ["*.pyc", "*.pyo", "*.so", "__pycache__"],
  "modules": [
    {
      "name": "python-nmap",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-cache-dir --prefix=/app ."
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://files.pythonhosted.org/packages/f7/1b/8e6b3d1461331e4e8600faf099e7c62ba3c1603987dafdd558681fb8ba37/python-nmap-0.7.1.tar.gz",
          "sha256": "f75af6b91dd8e3b0c31f869db32163f62ada686945e5b7c25f84bc0f7fad3b64"
        }
      ],
      "build-options": {
        "build-args": ["--share=network"]
      }
    },
    {
      "name": "dnspython",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --prefix=/app git+https://github.com/rthalley/dnspython.git"
      ],
      "build-options": {
        "env": {
          "FLATPAK_BUILD": "1"
        },
        "build-args": ["--share=network"]
      }
    },
    {
      "name": "python3-requests",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-cache-dir --prefix=/app git+https://github.com/psf/requests.git"
      ],
      "build-options": {
        "build-args": ["--share=network"]
      }
    },
    {
      "name": "pyyaml",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --no-cache-dir --prefix=/app https://files.pythonhosted.org/packages/05/8e/961c0007c59b8dd7729d542c61a4d537767a59645b82a0b521206e1e25c2/pyyaml-6.0.3.tar.gz"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://files.pythonhosted.org/packages/05/8e/961c0007c59b8dd7729d542c61a4d537767a59645b82a0b521206e1e25c2/pyyaml-6.0.3.tar.gz",
          "sha256": "d76623373421df22fb4cf8817020cbb7ef15c725b9d5e45f17e189bfc384190f"
        }
      ],
      "build-options": {
        "build-args": ["--share=network"]
      }
    },
    {
      "name": "nmap",
      "buildsystem": "simple",
      "build-commands": [
        "./configure --prefix=/app --without-zenmap --without-ndiff --without-nping --without-ncat",
        "make",
        "make install"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://nmap.org/dist/nmap-7.99.tar.bz2",
          "sha256": "df512492ffd108e53a27a06f26d8635bbe89e0e569455dc8ffef058c035d51b2"
        }
      ]
    },
    {
      "name": "woes",
      "buildsystem": "meson",
      "config-opts": ["--prefix=/app"],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/mclellac/woes.git",
          "branch": "main"
        }
      ],
      "build-options": {
        "build-args": ["--share=network"]
      }
    }
  ],
  "build-options": {
    "env": {}
  }
}
